<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="760" prefHeight="540"
  xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">

  <top>
    <VBox spacing="14" style="-fx-padding: 22 24 14 24;">

      <HBox styleClass="nav-bar" spacing="4">
        <Button text="📚  Бібліотека" styleClass="nav-btn-active"/>
        <Button text="🎶  Плейлисти" onAction="#onOpenPlaylistsClick" styleClass="nav-btn"/>
        <Button text="✂  Редагувати" onAction="#onEditClick" styleClass="nav-btn"/>
        <Button text="💱  Конвертер" onAction="#onOpenConverterClick" styleClass="nav-btn"/>
        <Button text="⚙  Налаштування" onAction="#onOpenSettingsClick" styleClass="nav-btn"/>
        <Button fx:id="adminButton" text="👤  Адмін" onAction="#onOpenAdminClick"
          visible="false" managed="false" styleClass="nav-btn"/>
      </HBox>

      <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="🎵 Музичний редактор" styleClass="page-title"/>
        <Label fx:id="welcomeLabel" styleClass="subtitle"/>
      </HBox>

      <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="🔍  Пошук за назвою..." HBox.hgrow="ALWAYS" styleClass="input-field"/>
        <Button text="Пошук" onAction="#onSearchClick" styleClass="btn-secondary"/>
        <Button text="＋ Додати трек" onAction="#onAddTrackClick" styleClass="btn-primary"/>
      </HBox>
    </VBox>
  </top>

  <center>
    <VBox styleClass="card" style="-fx-margin: 0 24 0 24;">
      <TableView fx:id="tracksTable" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="titleColumn" text="Назва" prefWidth="320"/>
          <TableColumn fx:id="durationColumn" text="Тривалість (с)" prefWidth="150"/>
          <TableColumn fx:id="addedDateColumn" text="Дата додавання" prefWidth="180"/>
        </columns>
      </TableView>
      <VBox.margin>
        <Insets left="24" right="24"/>
      </VBox.margin>
    </VBox>
  </center>

  <bottom>
    <VBox spacing="10" style="-fx-padding: 14 24 22 24;">
      <HBox spacing="10" alignment="CENTER">
        <Label fx:id="currentTimeLabel" text="00:00" styleClass="subtitle"/>
        <Slider fx:id="seekSlider" HBox.hgrow="ALWAYS" min="0" max="100" value="0"/>
        <Label fx:id="totalTimeLabel" text="00:00" styleClass="subtitle"/>
      </HBox>
      <HBox spacing="8" alignment="CENTER_RIGHT">
        <Button fx:id="playButton" text="▶  Відтворити" onAction="#onPlayClick" styleClass="btn-success"/>
        <Button text="⏹  Стоп" onAction="#onStopClick" styleClass="btn-secondary"/>
        <Button fx:id="deleteButton" text="Видалити" onAction="#onDeleteClick" styleClass="btn-danger"/>
      </HBox>
    </VBox>
  </bottom>
</BorderPane>