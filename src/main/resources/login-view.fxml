<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane prefWidth="420" prefHeight="520"
  xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
  <VBox alignment="CENTER" spacing="0" maxWidth="340" styleClass="card">
    <padding>
      <Insets top="36" right="34" bottom="30" left="34"/>
    </padding>

    <StackPane styleClass="logo-circle">
      <Label text="🎵" style="-fx-font-size: 26px;"/>
    </StackPane>

    <VBox alignment="CENTER" spacing="2" style="-fx-padding: 16 0 24 0;">
      <Label text="Музичний редактор" styleClass="page-title"/>
      <Label text="Вхід до системи" styleClass="subtitle"/>
    </VBox>

    <VBox spacing="10" fillWidth="true">
      <TextField fx:id="usernameField" promptText="Логін або email" styleClass="input-field"/>
      <PasswordField fx:id="passwordField" promptText="Пароль" styleClass="input-field"/>

      <Button text="Увійти" defaultButton="true" onAction="#onLoginClick"
        maxWidth="Infinity" styleClass="btn-primary" style="-fx-padding: 8 0 8 0;"/>
      <Button text="Немає акаунту? Зареєструватися" onAction="#onGoToRegisterClick"
        maxWidth="Infinity" styleClass="link-button"/>
    </VBox>

    <Label fx:id="errorLabel" wrapText="true" style="-fx-padding: 10 0 0 0;"/>

    <Button text="ℹ Про програму" onAction="#onAboutClick"
      maxWidth="Infinity" styleClass="link-button" style="-fx-padding: 14 0 0 0;"/>
  </VBox>
</StackPane>