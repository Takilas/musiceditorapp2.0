<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="480" prefHeight="640"
  xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">

  <top>
    <VBox spacing="14" style="-fx-padding: 22 30 14 30;">
      <HBox styleClass="nav-bar" spacing="4">
        <Button text="📚  Бібліотека" onAction="#onGoLibraryClick" styleClass="nav-btn"/>
        <Button text="🎶  Плейлисти" onAction="#onOpenPlaylistsClick" styleClass="nav-btn"/>
        <Button text="💱  Конвертер" onAction="#onOpenConverterClick" styleClass="nav-btn"/>
        <Button text="⚙  Налаштування" styleClass="nav-btn-active"/>
        <Button fx:id="adminButton" text="👤  Адмін" onAction="#onOpenAdminClick"
          visible="false" managed="false" styleClass="nav-btn"/>
      </HBox>
      <Label text="⚙ Налаштування" styleClass="page-title"/>
    </VBox>
  </top>

  <center>
    <VBox spacing="16">
      <BorderPane.margin>
        <Insets left="30" right="30" bottom="26"/>
      </BorderPane.margin>

      <VBox styleClass="card" spacing="10">
        <Label text="🎨  Тема оформлення" style="-fx-font-weight: bold;"/>
        <ChoiceBox fx:id="themeChoiceBox" maxWidth="Infinity" styleClass="input-field"/>
      </VBox>

      <VBox styleClass="card" spacing="10">
        <Label text="🔒  Зміна пароля" style="-fx-font-weight: bold;"/>
        <PasswordField fx:id="oldPasswordField" promptText="Поточний пароль" styleClass="input-field"/>
        <PasswordField fx:id="newPasswordField" promptText="Новий пароль" styleClass="input-field"/>
        <PasswordField fx:id="confirmPasswordField" promptText="Підтвердіть новий пароль" styleClass="input-field"/>
        <Button text="Змінити пароль" onAction="#onChangePasswordClick"
          maxWidth="Infinity" styleClass="btn-primary" style="-fx-padding: 9 0 9 0;"/>
        <Label fx:id="passwordStatusLabel" wrapText="true"/>
      </VBox>

      <Button text="🚪  Вийти з акаунту" onAction="#onLogoutClick"
        maxWidth="Infinity" styleClass="btn-danger" style="-fx-padding: 10 0 10 0;"/>
    </VBox>
  </center>
</BorderPane>