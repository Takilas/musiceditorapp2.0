<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="520" prefHeight="620"
  xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">

  <top>
    <VBox spacing="14" style="-fx-padding: 22 30 14 30;">
      <HBox styleClass="nav-bar" spacing="4">
        <Button text="📚  Бібліотека" onAction="#onGoLibraryClick" styleClass="nav-btn"/>
        <Button text="🎶  Плейлисти" onAction="#onOpenPlaylistsClick" styleClass="nav-btn"/>
        <Button text="💱  Конвертер" styleClass="nav-btn-active"/>
        <Button text="⚙  Налаштування" onAction="#onOpenSettingsClick" styleClass="nav-btn"/>
        <Button fx:id="adminButton" text="👤  Адмін" onAction="#onOpenAdminClick"
          visible="false" managed="false" styleClass="nav-btn"/>
      </HBox>
      <VBox spacing="2">
        <Label text="💱 Конвертер аудіо" styleClass="page-title"/>
        <Label text="Платна послуга: конвертація в MP3, WAV або MP4" styleClass="subtitle"/>
      </VBox>
    </VBox>
  </top>

  <center>
    <VBox styleClass="card" spacing="14">
      <BorderPane.margin>
        <Insets left="30" right="30" bottom="26"/>
      </BorderPane.margin>

      <VBox spacing="8">
        <Label text="🎵  Трек"/>
        <ChoiceBox fx:id="trackChoiceBox" maxWidth="Infinity" styleClass="input-field"/>
      </VBox>

      <VBox spacing="8">
        <Label text="🎯  Цільовий формат"/>
        <ChoiceBox fx:id="formatChoiceBox" maxWidth="Infinity" styleClass="input-field"/>
      </VBox>

      <Label fx:id="priceLabel" style="-fx-font-size: 15px; -fx-text-fill: #5B6EF5; -fx-font-weight: bold;"/>

      <Separator/>

      <Label text="💳  Дані картки"/>
      <VBox spacing="10">
        <TextField fx:id="cardNumberField" promptText="Номер картки (16 цифр)" styleClass="input-field"/>
        <HBox spacing="10">
          <TextField fx:id="expiryField" promptText="MM/YY" HBox.hgrow="ALWAYS" styleClass="input-field"/>
          <PasswordField fx:id="cvvField" promptText="CVV" HBox.hgrow="ALWAYS" styleClass="input-field"/>
        </HBox>
      </VBox>

      <Button fx:id="payButton" text="💸  Оплатити і конвертувати" onAction="#onPayAndConvertClick"
        maxWidth="Infinity" styleClass="btn-primary" style="-fx-padding: 10 0 10 0;"/>

      <ProgressIndicator fx:id="progressIndicator" maxWidth="36" maxHeight="36"/>
      <Label fx:id="statusLabel" wrapText="true"/>
    </VBox>
  </center>
</BorderPane>