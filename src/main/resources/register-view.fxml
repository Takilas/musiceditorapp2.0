<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane prefWidth="440" prefHeight="580"
  xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
  <VBox alignment="CENTER" spacing="0" maxWidth="360" styleClass="card">
    <padding>
      <Insets top="30" right="34" bottom="26" left="34"/>
    </padding>

    <StackPane styleClass="logo-circle">
      <Label text="🎵" style="-fx-font-size: 24px;"/>
    </StackPane>

    <Label text="Реєстрація" styleClass="page-title" style="-fx-padding: 14 0 18 0;"/>

    <VBox fx:id="registrationPane" spacing="10" alignment="CENTER" fillWidth="true">
      <TextField fx:id="usernameField" promptText="Ім'я користувача" styleClass="input-field"/>
      <TextField fx:id="emailField" promptText="Email" styleClass="input-field"/>
      <PasswordField fx:id="passwordField" promptText="Пароль" styleClass="input-field"/>
      <Button text="Зареєструватися" defaultButton="true" onAction="#onRegisterClick"
        maxWidth="Infinity" styleClass="btn-primary" style="-fx-padding: 8 0 8 0;"/>
      <Label fx:id="registerErrorLabel" wrapText="true"/>
    </VBox>

    <VBox fx:id="verificationPane" spacing="10" alignment="CENTER" visible="false" managed="false" fillWidth="true">
      <Label fx:id="verificationInfoLabel" wrapText="true" styleClass="subtitle"/>
      <TextField fx:id="codeField" promptText="Код з листа (6 цифр)" styleClass="input-field"/>
      <Button text="Підтвердити" defaultButton="true" onAction="#onVerifyClick"
        maxWidth="Infinity" styleClass="btn-primary" style="-fx-padding: 8 0 8 0;"/>
      <Label fx:id="verifyErrorLabel" wrapText="true"/>
    </VBox>

    <Button text="Назад до входу" onAction="#onBackToLoginClick"
      maxWidth="Infinity" styleClass="link-button" style="-fx-padding: 16 0 0 0;"/>
    <Button text="ℹ Про програму" onAction="#onAboutClick"
      maxWidth="Infinity" styleClass="link-button"/>
  </VBox>
</StackPane>